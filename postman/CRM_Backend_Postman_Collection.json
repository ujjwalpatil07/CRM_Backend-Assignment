      "name": "02 - Authentication",
      "item": [
        {
          "name": "Register Employee A (creates fresh email each run)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"email\": \"{{employeeAEmail}}\",\n  \"password\": \"SecurePass123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Employee A registration returns 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.test('Response contains JWT and employee', () => { pm.expect(data.token).to.be.a('string'); pm.expect(data.employee.email).to.eql(pm.environment.get('employeeAEmail')); });",
                  "pm.environment.set('tokenA', data.token);",
                  "pm.environment.set('employeeAId', data.employee.id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = Date.now();",
                  "pm.environment.set('employeeAEmail', `rahul.${runId}@example.com`);"
