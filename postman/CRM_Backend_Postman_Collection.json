    {
      "name": "05 - Public Leads",
      "item": [
        {
          "name": "Employee A fetches public leads",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/enquiries/public"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Public leads returns 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "const ids = data.enquiries.map(item => item._id);",
                  "pm.test('Both newly-created enquiries are in the public list', () => { pm.expect(ids).to.include(pm.environment.get('enquiryId')); pm.expect(ids).to.include(pm.environment.get('enquiryId2')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Employee A fetches public leads with pagination",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/enquiries/public?page=1&limit=1"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Paginated public leads returns 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('Pagination limit is applied', () => pm.expect(data.enquiries.length).to.be.at.most(1));",
                  "pm.test('Pagination metadata is present', () => { pm.expect(data.pagination.page).to.eql(1); pm.expect(data.pagination.limit).to.eql(1); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Public leads with invalid page and limit values",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/enquiries/public?page=-3&limit=-1"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid pagination values fall back safely', () => pm.response.to.have.status(200));",
                  "const pagination = pm.response.json().pagination;",
                  "pm.test('Fallback values are page 1 and limit 20', () => { pm.expect(pagination.page).to.eql(1); pm.expect(pagination.limit).to.eql(20); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Public leads with limit greater than 100",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/enquiries/public?page=1&limit=1000"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
